# Certo — HTTPS access from the local network (phone/tablet).
#
# The service worker and PWA installation require a secure context:
# over plain HTTP, only http://localhost works. This reverse proxy exposes
# the uvicorn API over HTTPS with a local certificate issued by Caddy.
#
# Usage:
#   1. install Caddy (https://caddyserver.com), a single binary
#   2. start the API:  python -m uvicorn sure_weather.api:app --port 8000
#   3. start the proxy: caddy run --config Caddyfile
#   4. on the phone: https://<PC-IP>:8443
#      (accept Caddy's local certificate once)
#      -> Chrome Android: "Installer l'application" / iOS Safari:
#         Share -> "Sur l'écran d'accueil" (UI labels, French locale)
#
# Replace :8443 with :443 if the port is free. `tls internal` requires
# trusting Caddy's root certificate on first run.
# `http_port`: port 80 is often reserved by Windows without admin rights,
# so the HTTP->HTTPS redirect listens on 8080 instead.

{
	http_port 8080
}

# Internal certificates issued explicitly for localhost and the LAN IP
# (update the IP if DHCP changes it).
https://127.0.0.1:8443 https://{$EXTERNAL_IP}:8443 {
	tls internal
	encode gzip
	reverse_proxy 127.0.0.1:8000
}
