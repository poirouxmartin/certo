<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">

    <!-- Place + timestamp. The ⟳ (32 dp) moved onto the map: in this row
         it forced 32 dp of height for ~21 dp of text, and at font scale 1.15
         the wind row fell off the bottom (Pixel 8, 15 Nov 2026). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_place"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <TextView
            android:id="@+id/widget_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Info on the left, map on the right; the row takes all the remaining height
         (else an empty band stays at the bottom of the 2-row widget) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <!-- Now: icon + temp, then description and rain summary in a column -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️"
                    android:textSize="34sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textSize="34sp"
                    android:includeFontPadding="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:layout_marginEnd="6dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="#F1F5F9"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/widget_rain_when"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#93C5FD"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Next hours: hour, icon, temp, rain (blank under 20 %), wind;
                 takes the remaining height, centred -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <LinearLayout android:id="@+id/h0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h0_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h0_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h0_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h0_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h0_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/h1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h1_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h1_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h1_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h1_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h1_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/h2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h2_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h2_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h2_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h2_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h2_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/h3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h3_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h3_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h3_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h3_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h3_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/h4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h4_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h4_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h4_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h4_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h4_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/h5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/h5_time" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CBD5E1" android:text="--" />
                    <TextView android:id="@+id/h5_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="" />
                    <TextView android:id="@+id/h5_temp" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="" />
                    <TextView android:id="@+id/h5_rain" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#93C5FD" android:text="" />
                    <TextView android:id="@+id/h5_wind" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CBD5E1" android:text="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Radar map: 140 dp wide, free height (images not stretched, fitCenter) -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical">

            <ViewFlipper
                android:id="@+id/widget_rain_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="450"
                android:inAnimation="@anim/widget_fade_in"
                android:outAnimation="@anim/widget_fade_out" />

            <!-- Coin haut droit : le coin haut gauche porte l'heure de l'image -->
            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:text="⟳"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/widget_chip" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
